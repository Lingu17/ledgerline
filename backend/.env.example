# Copy to backend/.env. Only the keys below are read; nothing else in the environment is touched.
# Leave everything blank to run the LOCAL WORKSPACE (simulated bank, offline evidence rules, synthetic data).

# --- Server
LEDGERLINE_HOST=127.0.0.1
LEDGERLINE_PORT=8000
# Set by hosts such as Render instead of LEDGERLINE_PORT; leave blank here.
PORT=
# Set to 1 when served over HTTPS (adds the Secure cookie flag). Required to bind a non-loopback host.
LEDGERLINE_COOKIE_SECURE=0
# 0 disables self-service sign-up (new people then join only by invitation; bootstrap with python -m ledgerline.manage create-owner)
LEDGERLINE_ALLOW_SIGNUP=1
LEDGERLINE_LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call state-changing endpoints.
LEDGERLINE_ALLOWED_ORIGINS=
# Sample organizations: 1 = also receive the six reference deposits on creation; 0 = customers/invoices only
LEDGERLINE_SAMPLE_WORKSPACE=1
# stdio (subprocess, default) or memory (in-process) transport for the payer-agent MCP server
LEDGERLINE_PAYER_MCP_TRANSPORT=stdio

# --- Airwallex SANDBOX (host is fixed to https://api.sandbox.airwallex.com/api/v1)
# Server-wide credentials. Each organization's owner chooses Local or Sandbox mode in Settings, sets its
# global account ids and its Airwallex webhook secret (stored in the control-plane DB, never returned to the browser).
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=

# --- Claude (optional evidence reader). Without a key the offline rules are used and labelled as such.
ANTHROPIC_API_KEY=
LEDGERLINE_CLAUDE_MODEL=claude-opus-5-5
# Daily Claude call budgets (UTC day). Every attempt counts, including failed ones.
LEDGERLINE_CLAUDE_DAILY_LIMIT=25
LEDGERLINE_CLAUDE_SERVER_DAILY_LIMIT=200

# --- Sign in with Google / Apple (optional). Buttons stay disabled until configured.
# Origin users reach this server on; redirect URIs are <LEDGERLINE_PUBLIC_URL>/api/auth/oauth/<provider>/callback
# and must be registered with each provider exactly.
LEDGERLINE_PUBLIC_URL=http://localhost:8000
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Developer -> Identifiers -> Services ID (Sign in with Apple enabled) + a Sign in with Apple key (.p8).
# Apple requires an HTTPS redirect URI, so it also needs LEDGERLINE_COOKIE_SECURE=1 behind TLS (not plain localhost).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# --- Storage
# Where companies' data, keys and backups live (default backend/var). On a server, a persistent disk.
LEDGERLINE_DATA_DIR=
# The control database file (default <LEDGERLINE_DATA_DIR>/ledgerline.sqlite3).
LEDGERLINE_DB_PATH=
# Refuse to start unless LEDGERLINE_DATA_DIR is inside this mounted path (guards against ephemeral disks).
LEDGERLINE_REQUIRE_PERSISTENT_MOUNT=
# Optional PostgreSQL instead of SQLite: postgresql://... with sslmode=require for a remote database.
LEDGERLINE_DATABASE_URL=
# Schema name prefix inside that database (default ll).
LEDGERLINE_PG_SCHEMA_PREFIX=
# 1 = refuse to start without LEDGERLINE_DATABASE_URL.
LEDGERLINE_REQUIRE_DATABASE=0
# 32+ random characters; encrypts keys held in the database. Required with LEDGERLINE_DATABASE_URL. Never commit it.
LEDGERLINE_SECRET_KEY=
# File holding the key that encrypts companies' own Airwallex connections (default <LEDGERLINE_DATA_DIR>/connections.key).
LEDGERLINE_CONNECTIONS_KEY_PATH=

# --- Bank
# local (simulated bank, default) or airwallex_sandbox (server-wide sandbox keys above).
LEDGERLINE_PROVIDER=local
# Organization ids allowed to use the server-wide sandbox keys (comma-separated). Everyone else stays simulated.
LEDGERLINE_SANDBOX_ORGS=
# Server-wide Airwallex webhook secret, and global account ids per currency (EUR:id,USD:id).
AIRWALLEX_WEBHOOK_SECRET=
AIRWALLEX_GLOBAL_ACCOUNT_IDS=
# Secret for the simulated bank's own test webhooks (a built-in non-production value is used when blank).
LEDGERLINE_WEBHOOK_SECRET=
# Unix socket of the separate sending service that holds the bank keys (deploy/vm); blank = this process calls the bank.
LEDGERLINE_SENDER_SOCKET=

# --- Payer agents
# Tests only: lets a customer's agent be on 127.0.0.1. Never set on a public server.
LEDGERLINE_PAYER_AGENT_ALLOW_LOOPBACK=0

# --- Behind a proxy
# How many proxies in front of this server to trust for the caller's address (0-5; Caddy alone = 1).
LEDGERLINE_TRUSTED_PROXY_HOPS=0
# Shared secret an edge proxy adds to each request, if one is used. Never commit it.
LEDGERLINE_EDGE_SECRET=
# mailto: or https:// address published in /.well-known/security.txt. Blank = no security.txt.
LEDGERLINE_SECURITY_CONTACT=

# --- Sign-up and judge demo limits
# New self-service companies per address per hour and per day, and in total per day.
LEDGERLINE_SIGNUP_PER_IP_HOUR=10
LEDGERLINE_SIGNUP_PER_IP_DAY=40
LEDGERLINE_SIGNUP_PER_DAY=500
# One-click judge demo (a practice company with Judge A and Teammate B, simulated bank, deleted after 48 hours). 0 turns it off.
LEDGERLINE_JUDGE_DEMO=1
# Judge demos per address per hour, and in total per day.
LEDGERLINE_JUDGE_DEMO_PER_IP_HOUR=30
LEDGERLINE_JUDGE_DEMO_PER_DAY=300
