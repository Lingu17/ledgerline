# Copy to backend/.env. Only the keys below are read; nothing else in the environment is touched.
# Leave everything blank to run the LOCAL WORKSPACE (simulated bank, offline evidence rules, synthetic data).

# --- Server
LEDGERLINE_HOST=127.0.0.1
LEDGERLINE_PORT=8000
# Set to 1 when served over HTTPS (adds the Secure cookie flag). Required to bind a non-loopback host.
LEDGERLINE_COOKIE_SECURE=0
# 0 disables self-service sign-up (new people then join only by invitation; bootstrap with python -m ledgerline.manage create-owner)
LEDGERLINE_ALLOW_SIGNUP=1
LEDGERLINE_LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call state-changing endpoints.
LEDGERLINE_ALLOWED_ORIGINS=
# Sample organizations: 1 = also receive the six reference deposits on creation; 0 = customers/invoices only
LEDGERLINE_SAMPLE_WORKSPACE=1
# stdio (subprocess, default) or memory (in-process) transport for the payer-agent MCP server
LEDGERLINE_PAYER_MCP_TRANSPORT=stdio

# --- Airwallex SANDBOX (host is fixed to https://api.sandbox.airwallex.com/api/v1)
# Server-wide credentials. Each organization's owner chooses Local or Sandbox mode in Settings, sets its
# global account ids and its Airwallex webhook secret (stored in the control-plane DB, never returned to the browser).
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=

# --- Claude (optional evidence reader). Without a key the offline rules are used and labelled as such.
ANTHROPIC_API_KEY=
LEDGERLINE_CLAUDE_MODEL=claude-opus-5-5
# Daily Claude call budgets (UTC day). Every attempt counts, including failed ones.
LEDGERLINE_CLAUDE_DAILY_LIMIT=25
LEDGERLINE_CLAUDE_SERVER_DAILY_LIMIT=200

# --- Sign in with Google / Apple (optional). Buttons stay disabled until configured.
# Origin users reach this server on; redirect URIs are <LEDGERLINE_PUBLIC_URL>/api/auth/oauth/<provider>/callback
# and must be registered with each provider exactly.
LEDGERLINE_PUBLIC_URL=http://localhost:8000
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Developer -> Identifiers -> Services ID (Sign in with Apple enabled) + a Sign in with Apple key (.p8).
# Apple requires an HTTPS redirect URI, so it also needs LEDGERLINE_COOKIE_SECURE=1 behind TLS (not plain localhost).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
